 impl Sdk {
+	/// Cancels a sign-in that is waiting for its second factor, as the
+	/// official client's `LoginFacade.cancelCreateSession` does: an
+	/// unauthenticated `SecondFactorAuthService` DELETE naming the pending
+	/// session, which the server then drops. The caller decides what a
+	/// `NotFoundError` (no second factor pending any more) or a `LockedError`
+	/// (a code being checked at the same moment) means.
+	pub async fn cancel_second_factor(&self, access_token: &str) -> Result<(), LoginError> {
+		let session_id =
+			parse_session_id(access_token).map_err(|e| LoginError::InvalidAccessToken {
+				error_message: format!("{e}"),
+			})?;
+		let service_executor = self.make_unauthenticated_service_executor();
+		service_executor
+			.delete::<SecondFactorAuthService>(
+				SecondFactorAuthDeleteData {
+					_format: 0,
+					session: session_id,
+				},
+				ExtraServiceParams::default(),
+			)
+			.await?;
+		Ok(())
+	}
+
